prefix_rule(pattern=["python", "interfaces/telegram/scripts/publish_artifact.py"], decision="allow")
prefix_rule(pattern=["python", "interfaces/telegram/scripts/restart_gateway.py", "request"], decision="allow")

prefix_rule(pattern=["python", "skills/calendar/scripts/calendar.py"], decision="allow")
